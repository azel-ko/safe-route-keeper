[Unit]
Description=SafeRoute direct HTTP auto-login keeper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart="@NODE_BIN@" "@PROJECT_DIR@/keeper.mjs" run
Restart=always
RestartSec=60
Environment=SAFE_ROUTE_INTERVAL_MS=60000
Environment=SAFE_ROUTE_CREDENTIALS_FILE=@CREDENTIALS_FILE@

[Install]
WantedBy=default.target
